addOpacitySlider(hillshadeLayer, 'Hillshade 1st Gen - 1m');

//interval toggle function for contours
function getCurrentIntervals() {
    const z = map.getZoom();
    if (z >= 18)      return { reg: 1, idx: 5 };
    else if (z >= 16) return { reg: 2, idx: 10 };
    else if (z >= 15) return { reg: 10, idx: 50 };
    else if (z >= 12) return { reg: 50, idx: 250 };
    else              return { reg: 0, idx: 0 }; // Too far out
}

//color toggle function
function addColorToggle(layer, labelText) {
  setTimeout(() => {
    const overlays = document.querySelectorAll('.leaflet-control-layers-overlays label');

    overlays.forEach(label => {
      const visibleText = label.innerText.trim();

      if (visibleText === labelText) {
        if (label.querySelector('.layer-color-toggle-wrapper')) return;

        // Container for alignment
        const wrapper = document.createElement('div');
        wrapper.className = 'layer-color-toggle-wrapper';
        wrapper.style.paddingLeft = '25px';
        wrapper.style.marginTop = '6px';
        wrapper.style.marginBottom = '4px';

        const button = document.createElement('button');
        button.className = 'layer-color-toggle-btn';

        const palette = [
          { name: 'Yellow', rgb: [254, 204, 52] },
          { name: 'Red',    rgb: [255, 0, 0] },
          { name: 'Black',  rgb: [0, 0, 0] }
        ];

        let colorIndex = 0; 

        // Helper function to update button appearance
        const updateButtonUI = () => {
          const current = palette[colorIndex];
          button.innerHTML = `
            <span class="color-swatch-circle" style="background: rgb(${current.rgb.join(',')})"></span>
            <span>${current.name}</span>
          `;
        };

        // Initialize UI
        updateButtonUI();

        button.onclick = function (e) {
          e.preventDefault();
          e.stopPropagation();

          colorIndex = (colorIndex + 1) % palette.length;
          currentContourRGB = palette[colorIndex].rgb;
          
          updateButtonUI();
          updateDynamicContours();

          // Refresh Legend
          const container = contourLegend.getContainer();
          if (container) updateContourLegendHTML(container);  
        };

        L.DomEvent.disableClickPropagation(wrapper);
        wrapper.appendChild(button);
        label.appendChild(wrapper);
      }
    });
  }, 100);
}

