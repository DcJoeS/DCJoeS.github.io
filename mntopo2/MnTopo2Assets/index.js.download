// Checks all DEM layers and builds a combined legend
function refreshElevationLegend() {
    const layers = [
        { layer: demLayer, id: 'grayscale', name: '2nd Gen Grayscale (0.5m)' },
        { layer: demLayerTerrain, id: 'terrain', name: '2nd Gen Terrain (0.5m)' },
        { layer: demLayerColorized, id: 'accessible', name: '2nd Gen Accessible (0.5m)' },
        { layer: demLayer1stGen, id: '1stgen', name: '1st Gen Color (1m)' }
    ];

    // Filter to only active layers
    const activeRamps = layers.filter(item => map.hasLayer(item.layer));

    // If none are active, remove the legend from the map
    if (activeRamps.length === 0) {
        elevationLegend.remove();
        return;
    }

    // Ensure legend is on the map
    if (!map.hasLayer(elevationLegend)) {
        elevationLegend.addTo(map);
    }

    const container = elevationLegend.getContainer();
    
    // Build HTML for all active ramps
    let html = `<div class="legend-title">Elevation</div>`;
    
    // Wrap the ramps in a flex container to show them side-by-side
    html += `<div style="display: flex; gap: 15px; align-items: flex-end;">`;

    activeRamps.forEach(ramp => {
        html += `
            <div>
                <div style="font-size: 9px; font-weight: bold; color: #666; margin-bottom: 4px; text-align: center; max-width: 60px; line-height: 1;">${ramp.name}</div>
                <div class="elevation-ramp-container">
                    <div class="elevation-ramp-bar ramp-${ramp.id}"></div>
                    <div class="elevation-ramp-labels">
                        <span>High</span>
                        <span>Low</span>
                    </div>
                </div>
            </div>
        `;
    });

    html += `</div>`;
    container.innerHTML = html;
}

// FEMA legend control
const femaLegend = L.control({ position: 'bottomright' });

// Helper function to update FEMA Legend HTML based on zoom
function updateFemaLegendHTML(div) {
  if (!div) return;
  
  const z = map.getZoom();
  const MIN_FEMA_ZOOM = 12;

  // If zoomed out too far
  if (z < MIN_FEMA_ZOOM) {
    div.innerHTML = `
      <div class="fema-legend">
        <div class="legend-title">FEMA Floodplains</div>
        <div style="font-size:10px; color:#666; margin-top:5px;">Zoom in to view</div>
      </div>`;
    return;
  }

  // Standard legend if zoomed in
  div.innerHTML = `
    <div class="fema-legend">
      <div class="legend-title">FEMA Floodplains</div>
      <div class="legend-item">
        <span class="legend-color" style="background:#FFEBBE;"></span>
        <span class="legend-label">Unmodernized</span>
      </div>
      <div class="legend-item">
        <span class="legend-color" style="background:#CD9C9B;"></span>
        <span class="legend-label">Modernized</span>
      </div>
    </div>
  `;
}

femaLegend.onAdd = function () {
  const div = L.DomUtil.create('div', 'leaflet-control'); // 'fema-legend' class is added inside the helper
  updateFemaLegendHTML(div);
  return div;
};

// Standard ray-casting algorithm for Point-in-Polygon
function isPointInPoly(pt, latlngs) {
    if (!latlngs) return false;
    // Handle MultiPolygons (nested arrays)
    if (Array.isArray(latlngs[0]) && ! (latlngs[0][0] instanceof L.LatLng) && typeof latlngs[0][0] !== 'object') {
        return latlngs.some(subPoly => isPointInPoly(pt, subPoly));
    }
    // Standard Polygon check
    let isInside = false;
    const poly = latlngs.flat(Infinity); // Flatten Leaflet's potential nested arrays
    for (let i = 0, j = poly.length - 1; i < poly.length; j = i++) {
        const xi = poly[i].lat, yi = poly[i].lng;
        const xj = poly[j].lat, yj = poly[j].lng;
        const intersect = ((yi > pt.lng) !== (yj > pt.lng)) &&
            (pt.lat < (xj - xi) * (pt.lng - yi) / (yj - yi) + xi);
        if (intersect) isInside = !isInside;
    }
    return isInside;
}

// This county layer used to query 1st gen lidar data
const countyLabels = {}; 

const lidarIndexLayer = L.esri.featureLayer({
  url: lidarIndexUrl,
  style: function () {
    return { color: "#53565A", weight: 2, fillOpacity: 0 };
  },
  onEachFeature: function (feature, layer) {
    const name = feature.properties.co_name;
    if (!name) return;

    const labelMarker = L.marker(layer.getBounds().getCenter(), {
      icon: L.divIcon({ className: 'hidden-label-marker' }),
      interactive: false,
      opacity: 0 
    });

    labelMarker.bindTooltip(name, {
      permanent: true,
      direction: "center",
      className: "county-label",
      opacity: 0 
    });

    labelMarker.addTo(map);
    
    countyLabels[feature.id || name] = {
      marker: labelMarker,
      polygon: layer,
      // Store the geometry coordinates once for faster checking
      latlngs: layer.getLatLngs()
    };
  }
});

function updateLabelPositions() {
  // SAFETY CHECK: If the county layer isn't on the map, stop immediately
  if (!map.hasLayer(lidarIndexLayer)) return;
  const zoom = map.getZoom();
  let dynamicSize = 14 + (zoom - 7) * 2; // Start at 14px, grow by 2px for every zoom level past 7
  dynamicSize = Math.max(12, Math.min(dynamicSize, 36)); // Clamp between 12px and 36px
  document.getElementById('map').style.setProperty('--county-label-size', dynamicSize + 'px');

  const mapBounds = map.getBounds();

  for (let id in countyLabels) {
    const item = countyLabels[id];
    const polyBounds = item.polygon.getBounds();

    // Calculate the intersection center
    const visibleSouth = Math.max(mapBounds.getSouth(), polyBounds.getSouth());
    const visibleWest = Math.max(mapBounds.getWest(), polyBounds.getWest());
    const visibleNorth = Math.min(mapBounds.getNorth(), polyBounds.getNorth());
    const visibleEast = Math.min(mapBounds.getEast(), polyBounds.getEast());

    if (visibleSouth < visibleNorth && visibleWest < visibleEast) {
      const visibleCenter = L.latLng(
        (visibleSouth + visibleNorth) / 2,
        (visibleWest + visibleEast) / 2
      );

      // Check if this point actually INSIDE the county?
      if (isPointInPoly(visibleCenter, item.latlngs)) {
          
          // If the marker isn't on the map (because it was toggled off), put it back
          if (!map.hasLayer(item.marker)) {
              item.marker.addTo(map);
          }
          
          item.marker.setLatLng(visibleCenter);
          item.marker.setOpacity(1);
          item.marker.getTooltip().setOpacity(0.9);
      } else {
          // If the visible center is in empty space, hide label
          item.marker.setOpacity(0);
          item.marker.getTooltip().setOpacity(0);
      }
    } else {
      // Off screen
      item.marker.setOpacity(0);
      item.marker.getTooltip().setOpacity(0);
    }
  }
}

// When the county layer is REMOVED from the map (toggled off)
lidarIndexLayer.on('remove', function() {
  for (let id in countyLabels) {
    const item = countyLabels[id];
    // Completely remove the marker from the map
    if (map.hasLayer(item.marker)) {
      map.removeLayer(item.marker);
    }
  }
});

// When the county layer is ADDED to the map (toggled on)
lidarIndexLayer.on('add', function() {
  // Trigger a recalculation to put the labels back in the right spots
  updateLabelPositions();
});

