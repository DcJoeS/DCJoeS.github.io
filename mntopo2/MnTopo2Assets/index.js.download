// Update the scale whenever map zooms or moves
function updateScale() {
  const div = document.querySelector('.custom-scale');

  // scale calculation constants
  const DPI = 96;                // standard screen resolution
  const inchesPerMeter = 39.37;  // 1 meter = 39.37 inches

  // Leaflet Web Mercator CRS
  const zoom = map.getZoom();
  const worldWidthPx = 256 * Math.pow(2, zoom); // pixels across the world at this zoom

  // Scale: 1 map unit = X ground units
  // Formula: scale = meters per pixel * inches per meter * DPI
  const metersPerPixel = 40075016.686 / worldWidthPx; // at equator, ignore cos(lat)
  const scaleRatio = Math.round(metersPerPixel * inchesPerMeter * DPI);

  div.innerHTML = `Scale: ${scaleRatio.toLocaleString()}`;
}

// Meter to feet conversion
const METERS_TO_FEET = 3.28084;
function metersToFeet(m) {
  return m * METERS_TO_FEET;
}

// Unit conversion helpers  
function metersToKilometers(m) {
  return m / 1000;
}

function metersToMiles(m) {
 return m * 0.000621371;
}
