      return new Promise(res => {
        L.esri.identifyImage({ url: demLayer.options.url }).at([latlng.lat, latlng.lng]).run((err, result) => {
          const val = result?.pixel?.properties?.value;
          res(val && val !== "NoData");
        });
      });
    });

    // USGS Fetch
    const usgsPromise = fetchUSGSPointCloud(shapeJson, activeAbortController.signal);

    // DNR 1st Gen Tile Index Fetch (Wrapped in a Promise)
    const tilePromise = new Promise(res => {
  if (!staticTileIndex) {
    console.warn("Tile index not yet loaded.");
    res([]);
    return;
  }

  // Use Turf.js to find intersections locally
  const userPoly = layer.toGeoJSON();
  const matchedTiles = staticTileIndex.features.filter(feature => {
    try {
      // booleanIntersects is very efficient for these types of grids
      return turf.booleanIntersects(userPoly, feature);
    } catch (e) {
      return false;
    }
  });

  res(matchedTiles);
});

    // Wait for everything to finish
    const [sampleResults, usgsItems, tileFeatures, contourFeatures] = await Promise.all([
      Promise.all(samplePromises),
      usgsPromise,
      tilePromise,
      contourTilePromise 
    ]);

    if (thisRequestId !== currentRequestId) return;

    spinner.style.display = 'none';
    window.activeBlobUrls = window.activeBlobUrls || [];

    const validCount = sampleResults.filter(v => v === true).length;
    const hasFullCoverage = validCount === sampleResults.length;
    const hasPartialCoverage = validCount > 0 && validCount < sampleResults.length;

// --- BUILD POPUP CONTENT ---
    let content = `<div class="elev-popup" style="max-height:400px; width:280px; overflow-y:auto; padding-right:5px;">
      <div class="popup-title">Lidar Data Access and Downloads</div>
      <hr style="border: none; border-top: 1px solid #78BE21; margin: 4px 0;">`;

// --- MN 2ND GEN / VRT SECTION ---
const vrtUrl = "https://stacbrowser.gis.data.mn.gov/collections/minnesota-virtual-raster-tile/items/2nd_Generation_Seamless_Lidar_DEM";

if (hasFullCoverage || hasPartialCoverage) {
    const label = hasFullCoverage ? "Minnesota 2nd Gen Data (2021-2024)" : "Partial Minnesota 2nd Gen (2021-2024)";

    const gen2Txt = `MN DNR 2nd Generation Seamless Lidar Derived Data\n` +
                    `-------------------------------------------\n` +
                    `Minnesota Seamless 0.5m DEM (Esri Image Service): https://enterprise.gisdata.mn.gov/agsimg/rest/services/MnTopo/2nd_Generation_Seamless_Lidar_DEM/ImageServer\n` +
                    `-------------------------------------------\n` +
                    `Minnesota Seamless 0.5m DEM VRT (Virtual Raster Tile): https://g46prsaddst01.blob.core.windows.net/mntopo/dem_100k/2nd_Generation_Seamless_Lidar_DEM.vrt\n` +
                    `-------------------------------------------\n` +
                    `Metadata: https://resources.gisdata.mn.gov/pub/gdrs/data/pub/us_mn_state_mngeo/elev_lidar_statewide_gen2/metadata/metadata.xml\n` +
                    `-------------------------------------------\n` +
                    `MnGeo STAC (SpatioTemporal Asset Catalog): https://stacbrowser.gis.data.mn.gov/\n` +
                    `-------------------------------------------\n` +
                    `Guide to Adding State of Minnesota’s Lidar Derived Data to Desktop Mapping Applications\n` +
                    `-------------------------------------------\n` +
                    `Tutorial: https://${window.location.hostname}/help-page/site/access/\n` +
                    `-------------------------------------------\n` +
                    `How to Video: https://${window.location.hostname}/help-page/site/video-tutorials/`;

    const gen2Blob = new Blob([gen2Txt], { type: 'text/plain' });
    const gen2FileUrl = URL.createObjectURL(gen2Blob);
    window.activeBlobUrls.push(gen2FileUrl);

    content += `<div style="margin-bottom:10px;">
        <b>${label}</b>
        
        <a href="${gen2FileUrl}" download="MN_2ndGen_Resource_Links.txt" 
           style="display: block; text-align: center; margin: 8px 0; padding: 6px; background: #003865; color: white; text-decoration: none; border-radius: 4px; font-size: 11px; font-weight: bold;">
          <i class="fa-solid fa-file-lines"></i> Download 2nd Gen Lidar Data Links
        </a>

        <a href="${vrtUrl}" target="_blank" 
           style="display: block; text-align: center; margin: 0 0 8px 0; padding: 6px; background: #003865; color: white; text-decoration: none; border-radius: 4px; font-size: 11px; font-weight: bold;">
          <i class="fa-solid fa-layer-group"></i> Access Lidar Data via STAC
        </a>

        <div style="margin-top: 5px;">
          <a href="https://${window.location.hostname}/help-page/site/access/" target="_blank" 
             style="display: block; font-size: 11px; color: #003865; text-decoration: underline;">
            <i class="fa-solid fa-arrow-up-right-from-square"></i>   How to add 2nd Gen Lidar data to ArcPro or QGIS
          </a>
        </div>
      </div>`;
    }else {
    content += `<div style="margin-bottom:10px;">
        <b style="font-size: 12px; color: #A6192E;"><i class="fa-solid fa-circle-exclamation"></i> No 2nd Gen data available in this area</b>
    </div>`;
}

// --- UNIFIED MN 1ST GEN SECTION (2008-2012) ---
const formatCounty = (name) => {
  if (!name) return 'unknown';
  return name.toLowerCase().replace(/\s+/g, '').replace(/\./g, '').replace('saint', 'st');
};

content += `<div style="margin-top:10px; padding-top:10px; border-top: 2px solid #00264c; margin-bottom:10px;">
    <b>1st Gen Data (2008-2012) within selected area</b>`;

// Check for LiDAR Tiles (GDB/LAZ)
if (tileFeatures && tileFeatures.length > 0) {
    let tileTxt = `MN DNR 1st Gen LiDAR - Direct Geodatabase Links\n` +
                  `For bulk downloads, we recommend using the uGet Download Manager.\n` +
                  `Generated on ${new Date().toLocaleString().replace(',', ' -')}\n` +
                  `Tiles Found: ${tileFeatures.length}\n` +
                  `-------------------------------------------\n\n`;

    tileFeatures.forEach(t => {
        const id = t.properties.dnr_qqq_id || t.properties.DNR_QQQ_ID;
        const rawC = t.properties.co_name;
        const finalCounty = rawC || (featureCollection.features[0] ? featureCollection.features[0].properties.co_name : 'unknown');

        if (id) {
            const cPath = formatCounty(finalCounty);
            const gdbUrl = `https://resources.gisdata.mn.gov/pub/data/elevation/lidar/county/${cPath}/geodatabase/${id}.gdb.zip`;
            const lazUrl = `https://resources.gisdata.mn.gov/pub/data/elevation/lidar/county/${cPath}/laz/${id}.laz`;
            tileTxt += `${gdbUrl}\n${lazUrl}\n`;
        }
    });

    const tileBlob = new Blob([tileTxt], { type: 'text/plain' });
    const tileUrl = URL.createObjectURL(tileBlob);
    window.activeBlobUrls.push(tileUrl);

    content += `<p style="font-size: 11px; margin: 4px 0;">Found <b>${tileFeatures.length}</b> lidar tiles.</p>
    <a href="${tileUrl}" download="MN_1stGen_Tile_Links.txt" 
       style="display: block; text-align: center; margin-bottom: 8px; padding: 6px; background: #003865; color: white; text-decoration: none; border-radius: 4px; font-size: 11px; font-weight: bold;">
      <i class="fa-solid fa-file-lines"></i> Download 1st Gen Lidar Data Links
    </a>`;
}

// Check for 2ft Contours (.shp)
if (contourFeatures && contourFeatures.length > 0) {
    let contourTxt = `MN DNR 1st Gen 2ft Contours - Shapefile Links\n` +
                  `For bulk downloads, we recommend using the uGet Download Manager.\n` +
                  `Generated on ${new Date().toLocaleString()}\n` +
                  `10k tiles found: ${contourFeatures.length}\n` +
                  `-------------------------------------------\n\n`;

    contourFeatures.forEach(t => {
        const k10 = t.properties.k10 || t.properties.K10 || t.properties.TILE_NAME; 
        if (k10) {
            const shpUrl = `https://g46prsaddst01.blob.core.windows.net/mntopo/shp/${k10}_1stGen_2ft_Contours.zip`;
            contourTxt += `${shpUrl}\n`;
        }
    });

    const contourBlob = new Blob([contourTxt], { type: 'text/plain' });
    const contourUrl = URL.createObjectURL(contourBlob);
    window.activeBlobUrls.push(contourUrl);

    content += `<p style="font-size: 11px; margin: 4px 0;">Found <b>${contourFeatures.length}</b> contour 10k tiles.</p>
    <a href="${contourUrl}" download="MN_1stGen_2ft_Contour_Links.txt" 
       style="display: block; text-align: center; margin-top: 5px; padding: 6px; background: #003865; color: white; text-decoration: none; border-radius: 4px; font-size: 11px; font-weight: bold;">
      <i class="fa-solid fa-file-lines"></i> Download 1st Gen Contour Shapefile Links
    </a>`;
}

// If neither exist
if ((!tileFeatures || tileFeatures.length === 0) && (!contourFeatures || contourFeatures.length === 0)) {
    content += `<p style="font-size: 11px; color: #666; margin-top: 5px;">No 1st Gen tiles found in this selection.</p>`;
}

content += `</div>`;

    // --- USGS SECTION ---
    if (usgsItems === null) {
  // Scenario 3: FETCH FAILED (Error/Timeout)
  content += `<div style="margin-top:10px; padding-top:10px; border-top: 2px solid #A6192E;">
    <b style="color: #A6192E;"><i class="fa-solid fa-circle-exclamation"></i> USGS Data Timeout</b><br>
    <p style="font-size: 11px; margin: 5px 0; color: #444;">
      Failed to grab USGS data after multiple attempts. The federal server may be limiting requests.
    </p>
    <a href="https://apps.nationalmap.gov/downloader/" target="_blank" 
       style="display: block; margin-top: 5px; font-size: 11px; color: #003865; font-weight: bold; text-decoration: underline;">
      <i class="fa-solid fa-arrow-up-right-from-square"></i> Try the National Map Downloader
    </a>
  </div>`;
} 
else if (usgsItems.length > 0) {
      const validItems = usgsItems.filter(item => item.downloadURL || item.url);
      const eraNew = []; 
      const eraOld = [];

      validItems.forEach(item => {
    const url = item.downloadURL || item.url || "";
    const title = item.title || "";
    const pubDate = item.publicationDate || "";

    // Regex to find a 4-digit year starting with 19 or 20
    // \b ensures we don't catch parts of longer numbers (like coordinates)
    const yearRegex = /\b(19|20)\d{2}\b/;

    let year = 0;

    // Check the URL first (Most reliable for USGS project names: e.g., "...2008...")
    const urlMatch = url.match(yearRegex);
    // Check the Title (e.g., "Minnesota Driftless 2021")
    const titleMatch = title.match(yearRegex);
    // Fallback to Publication Date
    const pubMatch = pubDate.match(yearRegex);

    if (urlMatch) {
        year = parseInt(urlMatch[0]);
    } else if (titleMatch) {
        year = parseInt(titleMatch[0]);
    } else if (pubMatch) {
        year = parseInt(pubMatch[0]);
    }

    // Sort into buckets
    if (year >= 2020) {
        eraNew.push(item);
    } else {
        eraOld.push(item);
    }
});

const buildUsgsList = (items, label) => {
    let h = `USGS 3DEP Lidar - ${label}\n` +
            `For bulk downloads, we recommend using the uGet Download Manager. Instructions:- https://apps.nationalmap.gov/uget-instructions/\n` +
            `Generated on ${new Date().toLocaleString().replace(',', ' -')}\n` +
            `Files Found: ${items.length}\n` +
            `-------------------------------------------\n\n`;
    return h + items.map(i => i.downloadURL || i.url).join('\n');
};

      content += `<div style="margin-top:10px; padding-top:10px; border-top: 2px solid #00264c;">
                    <b style="color: #003865;">USGS 3DEP Point Clouds within selected area</b>`;

      if (eraNew.length > 0) {
        const b = new Blob([buildUsgsList(eraNew, "2020+ Data")], { type: 'text/plain' });
        const u = URL.createObjectURL(b);
        window.activeBlobUrls.push(u);
        content += `<p style="font-size: 11px; margin: 8px 0 4px 0;">Found <b>${eraNew.length}</b> LAZ files (2020+):</p>
          <a href="${u}" download="USGS_Lidar_2020_Present.txt" style="display: block; text-align: center; padding: 6px; background: #003865; color: white; text-decoration: none; border-radius: 4px; font-size: 11px; font-weight: bold;">
          <i class="fa-solid fa-file-lines"></i> Download 2nd Gen LAZ Data Links</a>`;
      }
      if (eraOld.length > 0) {
        const b = new Blob([buildUsgsList(eraOld, "Pre-2020 Data")], { type: 'text/plain' });
        const u = URL.createObjectURL(b);
        window.activeBlobUrls.push(u);
        content += `<p style="font-size: 11px; margin: 12px 0 4px 0;">Found <b>${eraOld.length}</b> LAZ files (Pre-2020):</p>
          <a href="${u}" download="USGS_Lidar_2019_Older.txt" style="display: block; text-align: center; padding: 6px; background: #003865; color: white; text-decoration: none; border-radius: 4px; font-size: 11px; font-weight: bold;">
          <i class="fa-solid fa-file-lines"></i> Download 1st Gen LAZ Data Links</a>`;
      }
      content += `</div>`;
    }

    content += `</div>`;

    L.popup().setLatLng(bounds.getCenter()).setContent(content).openOn(map);

    // --- POPUP CLEANUP ---
    map.once('popupclose', function () {
      drawnItems.clearLayers();
      if (window.activeBlobUrls) {
        window.activeBlobUrls.forEach(url => URL.revokeObjectURL(url));
        window.activeBlobUrls = [];
      }
    });
  });
}

// --- Logic for LINE (Polyline) ---
if (layer instanceof L.Polyline) {
  const latlngs = layer.getLatLngs();
  currentProfileLine = layer;
  const numPoints = 101; 
  const points = interpolateFixedPoints(latlngs, numPoints); 

  spinner.style.display = 'block';

  const fetchGetSamples = (url, pointData, callback) => {
    const esriPoints = pointData.map(p => [p[1], p[0]]); // [lon, lat]

    L.esri.request(url + '/getSamples', {
      geometry: JSON.stringify({
        points: esriPoints,
        spatialReference: { wkid: 4326 }
      }),
      geometryType: 'esriGeometryMultipoint',
      returnFirstValueOnly: true,
      f: 'json'
    }, (err, response) => {
      if (err || !response || !response.samples) {
        callback(pointData.map(p => ({ dist: p[2], elev: null, lat: p[0], lon: p[1] })));
        return;
      }

      // SPATIAL MATCHING:
      const results = pointData.map((pt) => {
        const ptLat = pt[0];
        const ptLon = pt[1];

        // Find the sample in the response that matches this coordinate
        // We use a small tolerance (0.0001) for float comparison
        const match = response.samples.find(s => {
            return Math.abs(s.location.y - ptLat) < 0.0001 && 
                   Math.abs(s.location.x - ptLon) < 0.0001;
        });

        const val = match ? match.value : "NoData";
        let cleanElev = null;

        if (val !== "NoData" && val !== null && val !== undefined) {
          const num = parseFloat(val);
          if (!isNaN(num) && num > -9000) cleanElev = num;
        }

        return {
          dist: pt[2],
          elev: cleanElev,
          lat: ptLat,
          lon: ptLon
        };
      });

      callback(results);
    });
  };

  let completed = 0;
  fetchGetSamples(demLayer.options.url, points, (res) => {
    if (thisRequestId !== currentRequestId) return;
    window.lastElevations2ndGen = res;
    if (++completed === 2) finalizeLine();
  });

  fetchGetSamples(demLayer1stGenImageServer, points, (res) => {
    if (thisRequestId !== currentRequestId) return;
    window.lastElevations1stGen = res;
    if (++completed === 2) finalizeLine();
  });

  function finalizeLine() {
    spinner.style.display = 'none';
    showProfileChart(); 
    refreshProfileRoadCrossings();
    if (activeToolType === 'polyline') setTimeout(() => { if (currentDrawHandler) currentDrawHandler.enable(); }, 100);
  }
}
});

// --- ELEVATION CHART RENDERING ---
function showProfileChart(chartTitleOverride = null) {
  const selectedGen = document.querySelector('input[name="gen-source"]:checked')?.value || "2";
  const elevations = (selectedGen === "2") ? window.lastElevations2ndGen : window.lastElevations1stGen;
  const isMobile = window.innerWidth < 768;
  
  if (!elevations || elevations.length === 0) {
      if (window.elevChart) window.elevChart.destroy();
      return;
  }

  profilePanel.classList.add('visible');
  profilePanel.setAttribute('aria-hidden', 'false');

  const useFeet = currentUnits === 'ft';
  // Use 1st Gen to determine the absolute max distance of the line
  const totalDistanceMeters = window.lastElevations1stGen[window.lastElevations1stGen.length - 1].dist;

  let distUnit, distConv;
  if (useFeet) {
    if (totalDistanceMeters * 3.28084 > 5280) { distUnit = 'mi'; distConv = m => m * 0.000621371; }
    else { distUnit = 'ft'; distConv = m => m * 3.28084; }
  } else {
    if (totalDistanceMeters > 1000) { distUnit = 'km'; distConv = m => m / 1000; }
    else { distUnit = 'm'; distConv = m => m; }
  }

  // BUILD XY DATA OBJECTS
  const chartPoints = elevations.map(e => ({
    x: distConv(e.dist),
    y: (e.elev === null) ? null : (useFeet ? e.elev * 3.28084 : e.elev)
  }));

  const is1stGen = (selectedGen === "1");
  const themeColor = is1stGen ? '#A6192E' : '#003865'; 
  const titleText = chartTitleOverride || (is1stGen ? "Elevation Profile - 1st Gen (1m)" : "Elevation Profile - 2nd Gen (0.5m)");

  const ctx = document.getElementById('elevationChart').getContext('2d');
  if (window.elevChart) window.elevChart.destroy();

  const gradient = ctx.createLinearGradient(0, 0, 0, 200);
  gradient.addColorStop(0, is1stGen ? 'rgba(166, 25, 46, 0.5)' : 'rgba(0, 56, 101, 0.5)');
  gradient.addColorStop(1, 'rgba(255, 255, 255, 0)');

  window.elevChart = new Chart(ctx, {
    type: 'line',
    data: {
      datasets: [{
        label: useFeet ? 'Elevation (ft)' : 'Elevation (m)',
        data: chartPoints, // Using XY objects
        fill: true,
        borderColor: themeColor,
        backgroundColor: gradient,
        borderWidth: 2,
        pointRadius: 0,
        tension: 0.1,
        spanGaps: false 
      }]
    },
    plugins: [profileRoadCrossingPlugin],
    options: {
      responsive: true,
      maintainAspectRatio: false,
      scales: {
        x: { 
          type: 'linear', // Required for XY data
          min: 0,
          max: distConv(totalDistanceMeters), // Lock the width
          title: { display: true, text: `Distance (${distUnit})`, color: themeColor },
          ticks: {
            callback: (val) => val.toFixed(distUnit === 'mi' || distUnit === 'km' ? 1 : 0)
          }
        },
        y: { 
          title: { display: true, text: useFeet ? 'Elevation (ft)' : 'Elevation (m)', color: themeColor } 
        }
      },
      plugins: {
        legend: { display: false },
        title: {
          display: true,
          text: titleText,
          color: themeColor,
          font: { size: 16, weight: 'bold' }
        }
      }
    }
  });
}

// --- GLOBAL UI LISTENERS ---
// Mobile swipe-to-close logic
const panelElement = document.getElementById('profile-panel');
let swipeStartY = 0;
if (panelElement) {
    panelElement.addEventListener('touchstart', e => {
        swipeStartY = e.touches[0].clientY;
    }, {passive: true});

    panelElement.addEventListener('touchend', e => {
        const endY = e.changedTouches[0].clientY;
        if (endY - swipeStartY > 80) resetMapDrawing();
    }, {passive: true});
}

// Handles redraw for both Metric/Imperial and 1st/2nd Gen toggles
document.querySelectorAll('input[name="units"], input[name="gen-source"]').forEach(input => {
  input.addEventListener('change', e => {
    if (e.target.name === 'units') currentUnits = e.target.value;
    showProfileChart(); 
  });
});
document.querySelectorAll('#show-road-crossings, #show-waterway-crossings').forEach(toggle => {
  toggle.addEventListener('change', refreshProfileRoadCrossings);
});
// CSV Export Logic
function exportToCSV(elevations, filename) {
  if (!elevations || elevations.filter(e => e && e.elev !== null).length === 0) {
    alert("No data available to export. Draw a line first!");
    return;
  }
  let csv = "Distance_m,Distance_ft,Elevation_m,Elevation_ft,Latitude,Longitude,Easting_m,Northing_m\n";
  elevations.filter(e => e && e.elev !== null).forEach(e => {
    const utm = latLngToUTM15({ lat: e.lat, lng: e.lon });
    csv += [
      e.dist.toFixed(2), (e.dist * 3.28084).toFixed(2),
      e.elev.toFixed(2), (e.elev * 3.28084).toFixed(2),
      e.lat.toFixed(5), e.lon.toFixed(5),
      utm ? utm.easting.toFixed(2) : "", utm ? utm.northing.toFixed(2) : ""
    ].join(",") + "\n";
  });
  const link = document.createElement("a");
  link.href = URL.createObjectURL(new Blob([csv], { type: "text/csv" }));
  link.download = filename;
  link.click();
}

document.getElementById('export-btn-2nd').onclick = () => exportToCSV(window.lastElevations2ndGen, "2ndGen_Profile.csv");
document.getElementById('export-btn-1st').onclick = () => exportToCSV(window.lastElevations1stGen, "1stGen_Profile.csv");

// Final reset and cleanup logic
function resetMapDrawing() {
  map.closePopup();
  if (currentDrawHandler) currentDrawHandler.disable();
  activeToolType = null; 
  document.querySelectorAll('.zoom-to-mn').forEach(btn => btn.classList.remove('active-tool'));
  drawnItems.clearLayers();
  if (customMarker) { map.removeLayer(customMarker); customMarker = null; }
  profilePanel.classList.remove('visible');
  if (spinner) spinner.style.display = 'none';
  if (activeAbortController) activeAbortController.abort();
  profileCrossingQueryId += 1;
  currentProfileLine = null;
  clearProfileRoadCrossings();
  document.getElementById('show-road-crossings').checked = false;
  document.getElementById('show-waterway-crossings').checked = false;
  profilePanel.setAttribute('aria-hidden', 'true');
  window.lastElevations2ndGen = null;
  window.lastElevations1stGen = null;
  if (window.elevChart) { window.elevChart.destroy(); window.elevChart = null; }
}

document.getElementById('close-profile').onclick = () => resetMapDrawing();

// --- INITIALIZATION ---
refreshElevationLegend();
map.on('movestart', function() {
  if (window.innerWidth < 768) layerControl.collapse();
});

// Fix for Leaflet calculation bug when reopening
layerControl.on('expand', function() {
    const container = layerControl.getContainer();
    // Force a height reset
    container.style.height = 'auto';
    
    // Optional: Scroll to top when opening
    container.scrollTop = 0;
});

// Close panel on mobile move
map.on('movestart', function() {
  if (window.innerWidth < 768) {
    layerControl.collapse();
  }
});
// Generation Toggle Listener
document.querySelectorAll('input[name="units"], input[name="gen-source"]').forEach(input => {
  input.addEventListener('change', e => {
    // Update the unit state if it was a unit button
    if (e.target.name === 'units') {
      currentUnits = e.target.value;
    }
    // Redraw the chart immediately
    showProfileChart(); 
  });
});

// CSV Export Logic
function exportCSV(elevations, filename) {
  if (!elevations || elevations.length === 0) return alert("No data available to export. Draw a line first!");
  let csv = "Distance_m,Distance_ft,Elevation_m,Elevation_ft,Latitude,Longitude,Easting_m,Northing_m\n";

  elevations.filter(e => e && e.elev !== null).forEach(e => {
    const utm = latLngToUTM15({ lat: e.lat, lng: e.lon });
    csv += [
      e.dist.toFixed(2), (e.dist * 3.28084).toFixed(2),
      e.elev.toFixed(2), (e.elev * 3.28084).toFixed(2),
      e.lat.toFixed(5), e.lon.toFixed(5),
      utm ? utm.easting.toFixed(2) : "", utm ? utm.northing.toFixed(2) : ""
    ].join(",") + "\n";
  });

  const link = document.createElement("a");
  link.href = URL.createObjectURL(new Blob([csv], { type: "text/csv" }));
  link.download = filename;
  link.click();
}

document.getElementById('export-btn-2nd').onclick = () => exportCSV(window.lastElevations2ndGen, "2ndGen_Elevation_Profile.csv");
document.getElementById('export-btn-1st').onclick = () => exportCSV(window.lastElevations1stGen, "1stGen_Elevation_Profile.csv");

// Final Reset Logic
function resetMapDrawing() {
  map.closePopup();
  if (currentDrawHandler) currentDrawHandler.disable();
  activeToolType = null; 
  document.querySelectorAll('.zoom-to-mn').forEach(btn => btn.classList.remove('active-tool'));
  drawnItems.clearLayers();
  if (customMarker) { map.removeLayer(customMarker); customMarker = null; }
  profilePanel.classList.remove('visible');
  profilePanel.setAttribute('aria-hidden', 'true');
  if (spinner) spinner.style.display = 'none';
  if (activeAbortController) activeAbortController.abort();
  profileCrossingQueryId += 1;
  currentProfileLine = null;
  clearProfileRoadCrossings();
  document.getElementById('show-road-crossings').checked = false;
  document.getElementById('show-waterway-crossings').checked = false;

  window.lastElevations2ndGen = null;
  window.lastElevations1stGen = null;
  if (window.elevChart) {
    window.elevChart.destroy();
    window.elevChart = null;
  }
}

// Initial Legened Check
refreshElevationLegend();