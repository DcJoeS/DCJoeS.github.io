// Interpolate evenly spaced points along polyline
function interpolateFixedPoints(latlngs, numPoints) {
  if (!latlngs || latlngs.length < 2) return [];
  const segs = [];
  const cumDist = [0];
  let totalDist = 0;
  for (let i = 0; i < latlngs.length - 1; i++) {
    const d = L.latLng(latlngs[i]).distanceTo(L.latLng(latlngs[i + 1]));
    segs.push(d);
    totalDist += d;
    cumDist.push(totalDist);
  }
  const points = [];
  for (let n = 0; n < numPoints; n++) {
    const targetDist = (n / (numPoints - 1)) * totalDist;
    let i = 0;
    while (i < segs.length && targetDist > cumDist[i + 1]) i++;
    const p1 = L.latLng(latlngs[i]);
    const p2 = L.latLng(latlngs[i + 1]);
    const segLength = segs[i];
    const frac = segLength === 0 ? 0 : (targetDist - cumDist[i]) / segLength;
    const lat = p1.lat + frac * (p2.lat - p1.lat);
    const lng = p1.lng + frac * (p2.lng - p1.lng);
    points.push([lat, lng, targetDist]);
  }
  points.sort((a, b) => a[2] - b[2]);
  return points;
}

let currentProfileLine = null;
let profileRoadCrossings = [];
let profileWaterwayCrossings = [];
let profileCrossingQueryId = 0;
const profileRoadLayer = L.layerGroup().addTo(map);

function clearProfileRoadCrossings() {
  profileRoadCrossings = [];
  profileWaterwayCrossings = [];
  profileRoadLayer.clearLayers();
}

function renderProfileRoadCrossings() {
  profileRoadLayer.clearLayers();
  [...profileRoadCrossings, ...profileWaterwayCrossings].forEach(crossing => {
    const isWaterway = crossing.type === 'waterway';
    L.circleMarker([crossing.lat, crossing.lon], {
      radius: 5,
      color: isWaterway ? '#007a78' : '#A6192E',
      weight: 2,
      fillColor: '#fff',
      fillOpacity: 1
    }).bindTooltip(crossing.name, {
      permanent: true,
      direction: 'top',
      offset: [0, -5],
      className: isWaterway ? 'profile-waterway-label' : 'profile-road-label'
    }).addTo(profileRoadLayer);
  });
}

function profileLineQueryParams(line, outFields) {
  const coordinates = line.getLatLngs().map(latlng => [latlng.lng, latlng.lat]);
  return {
    coordinates,
    params: new URLSearchParams({
      f: 'geojson',
      geometry: JSON.stringify({ paths: [coordinates], spatialReference: { wkid: 4326 } }),
      geometryType: 'esriGeometryPolyline',
      inSR: '4326',
      spatialRel: 'esriSpatialRelIntersects',
      outFields,
      returnGeometry: 'true',
      outSR: '4326'
    })
  };
}

function crossingFromIntersection(profileFeature, intersection, name, type) {
  const nearest = turf.nearestPointOnLine(profileFeature, intersection, { units: 'meters' });
  const distance = Number(nearest.properties?.location);
  if (!Number.isFinite(distance)) return null;
  return {
    name,
    type,
    distance,
    lat: intersection.geometry.coordinates[1],
    lon: intersection.geometry.coordinates[0]
  };
}

async function findProfileRoadCrossings(line, queryId) {
  const { coordinates, params } = profileLineQueryParams(line, 'ST_CONCAT');
  const response = await fetch(`${roadCenterlinesUrl}/query?${params}`);
  if (!response.ok) throw new Error(`Road service returned ${response.status}`);
  const data = await response.json();
  if (queryId !== profileCrossingQueryId) return [];

  const profileFeature = turf.lineString(coordinates);
  const crossings = [];
  (data.features || []).forEach(feature => {
    const name = String(feature.properties?.ST_CONCAT || '').trim();
    if (!name || !feature.geometry) return;
    const geometry = feature.geometry.type === 'MultiLineString'
      ? turf.multiLineString(feature.geometry.coordinates)
      : turf.lineString(feature.geometry.coordinates);
    turf.lineIntersect(profileFeature, geometry).features.forEach(intersection => {
      const crossing = crossingFromIntersection(profileFeature, intersection, name, 'road');
      if (crossing && !crossings.some(existing => existing.name === name)) crossings.push(crossing);
    });
  });
  return crossings.sort((a, b) => a.distance - b.distance);
}

async function findProfileWaterwayCrossings(line, queryId) {
  const { coordinates, params } = profileLineQueryParams(line, 'label');
  const response = await fetch(`${waterwaysUrl}/query?${params}`);
  if (!response.ok) throw new Error(`Waterway service returned ${response.status}`);
  const data = await response.json();
  if (queryId !== profileCrossingQueryId) return [];

  const profileFeature = turf.lineString(coordinates);
  const crossings = [];
  (data.features || []).forEach(feature => {
    const name = String(feature.properties?.label || feature.properties?.LABEL || '').trim();
    if (!name || !feature.geometry) return;
    const geometry = feature.geometry;
    let lines = [];
    if (geometry.type === 'LineString') {
      lines = [turf.lineString(geometry.coordinates)];
    } else if (geometry.type === 'MultiLineString') {
      lines = geometry.coordinates.map(coordinates => turf.lineString(coordinates));
    } else if (geometry.type === 'Polygon') {
      lines = geometry.coordinates.map(ring => turf.lineString(ring));
    } else if (geometry.type === 'MultiPolygon') {
      lines = geometry.coordinates.flatMap(polygon => polygon.map(ring => turf.lineString(ring)));
    }
    lines.forEach(waterwayLine => {
      turf.lineIntersect(profileFeature, waterwayLine).features.forEach(intersection => {
        const crossing = crossingFromIntersection(profileFeature, intersection, name, 'waterway');
        if (crossing) crossings.push(crossing);
      });
    });
  });
  return crossings.sort((a, b) => a.distance - b.distance);
}

function refreshProfileRoadCrossings() {
  profileCrossingQueryId += 1;
  const queryId = profileCrossingQueryId;
  clearProfileRoadCrossings();
  const roadToggle = document.getElementById('show-road-crossings');
  const waterwayToggle = document.getElementById('show-waterway-crossings');
  if (!currentProfileLine || (!roadToggle?.checked && !waterwayToggle?.checked)) {
    if (window.elevChart) window.elevChart.update();
    return;
  }

  const queries = [];
  if (roadToggle?.checked) queries.push(findProfileRoadCrossings(currentProfileLine, queryId)
    .then(crossings => ({ type: 'road', crossings }))
    .catch(() => ({ type: 'road', crossings: [] })));
  if (waterwayToggle?.checked) queries.push(findProfileWaterwayCrossings(currentProfileLine, queryId)
    .then(crossings => ({ type: 'waterway', crossings }))
    .catch(() => ({ type: 'waterway', crossings: [] })));
  Promise.all(queries)
    .then(results => {
      if (queryId !== profileCrossingQueryId) return;
      results.forEach(result => {
        if (result.type === 'road') profileRoadCrossings = result.crossings;
        if (result.type === 'waterway') profileWaterwayCrossings = result.crossings;
      });
      renderProfileRoadCrossings();
      if (window.elevChart) window.elevChart.update();
    })
}

const profileRoadCrossingPlugin = {
  id: 'profileRoadCrossings',
  afterDraw(chart) {
    const crossings = [...profileRoadCrossings, ...profileWaterwayCrossings];
    if (!crossings.length || !window.lastElevations1stGen?.length) return;
    const totalDistance = window.lastElevations1stGen[window.lastElevations1stGen.length - 1].dist;
    const xScale = chart.scales.x;
    const context = chart.ctx;
    context.save();
    crossings.forEach(crossing => {
      const color = crossing.type === 'waterway' ? '#007a78' : '#A6192E';
      const x = xScale.getPixelForValue(xScale.max * (crossing.distance / totalDistance));
      context.beginPath();
      context.setLineDash([4, 4]);
      context.moveTo(x, chart.chartArea.top);
      context.lineTo(x, chart.chartArea.bottom);
      context.strokeStyle = color;
      context.stroke();
      context.setLineDash([]);
      context.save();
      context.translate(x + 3, chart.chartArea.bottom - 4);
      context.rotate(-Math.PI / 2);
      const label = `${crossing.name} (${formatDistance(crossing.distance)})`;
      context.lineJoin = 'round';
      context.lineWidth = 3;
      context.strokeStyle = 'white';
      context.strokeText(label, 0, 0);
      context.fillStyle = color;
      context.fillText(label, 0, 0);
      context.restore();
    });
    context.restore();
  }
};

function formatDistance(distanceMeters) {
  const useFeet = currentUnits === 'ft';
  if (useFeet) {
    const feet = distanceMeters * 3.28084;
    return `${(feet > 5280 ? feet / 5280 : feet).toFixed(feet > 5280 ? 1 : 0)} ${feet > 5280 ? 'mi' : 'ft'}`;
  }
  return `${(distanceMeters > 1000 ? distanceMeters / 1000 : distanceMeters).toFixed(distanceMeters > 1000 ? 1 : 0)} ${distanceMeters > 1000 ? 'km' : 'm'}`;
}

// --- SINGLE Event Listener for Drawing ---
map.on(L.Draw.Event.CREATED, async function (event) {
  const layer = event.layer;

  if (activeAbortController) activeAbortController.abort(); // Kill current USGS fetch
  activeAbortController = new AbortController();
  
  currentRequestId++; // Increment global ID
  const thisRequestId = currentRequestId; // Capture THIS ID for this specific drawing

  drawnItems.clearLayers();
  profilePanel.classList.remove('visible');
  const roadToggle = document.getElementById('show-road-crossings');
  const waterwayToggle = document.getElementById('show-waterway-crossings');
  if (roadToggle) roadToggle.checked = false;
  if (waterwayToggle) waterwayToggle.checked = false;
  profileCrossingQueryId += 1;
  currentProfileLine = null;
  clearProfileRoadCrossings();

  if (customMarker) {
    map.removeLayer(customMarker);
    customMarker = null;
  }

  drawnItems.addLayer(layer);

  // --- Logic for POINT (Marker) ---
  if (layer instanceof L.Marker) {
    const latlng = layer.getLatLng();
    spinner.style.display = 'block';

    map.removeLayer(layer);

    const faIcon = L.divIcon({
      html: '<i class="fa-solid fa-location-dot custom-fa-icon" aria-label="Selected Elevation Point"></i>',
      className: '',
      iconSize: [24, 24],
      iconAnchor: [12, 24]
    });

    customMarker = L.marker(latlng, {
      icon: faIcon,
      title: "Selected Elevation Point",
      alt: "Selected Elevation Point"
    }).addTo(map);

    // Helper to wrap the Esri Identify call in a Promise
    const identifyElev = (url) => {
      return new Promise((resolve) => {
        L.esri.identifyImage({ url: url })
          .at([latlng.lat, latlng.lng])
          .run((error, result) => {
            if (error) resolve(null);
            const val = result?.pixel?.properties?.value;
            resolve((val && val !== "NoData") ? parseFloat(val) : null);
          });
      });
    };

    // Run both requests in parallel
    Promise.all([
      identifyElev(demLayer.options.url),           // 2nd Gen
      identifyElev(demLayer1stGenImageServer)        // 1st Gen
    ]).then(([elev2nd, elev1st]) => {
      spinner.style.display = 'none';
      const popupOptions = { offset: L.point(0, -30) };

      const lat = latlng.lat.toFixed(5);
      const lng = latlng.lng.toFixed(5);
      const utm = latLngToUTM15(latlng);
      const easting = utm ? utm.easting.toFixed(2) : "N/A";
      const northing = utm ? utm.northing.toFixed(2) : "N/A";

      // Build the Content String
      let content = `<div class="elev-popup">
        <div class="popup-title">Elevation Data and Coordinates</div>
        <hr style="border: none; border-top: 1px solid #78BE21; margin: 4px 0;">`;

      // --- 2nd Gen Section ---
      content += `<b style="color: #003865;"><u>2nd Gen Lidar (0.5m)</u></b><br>`;
      if (elev2nd !== null) {
        content += `${elev2nd.toFixed(2)} meters | ${(elev2nd * 3.28084).toFixed(1)} feet<br>`;
      } else {
        content += `<span style="color: #A6192E; font-size: 11px;">Data not available in this area</span><br>`;
      }

      content += `<div style="margin-top: 5px;"></div>`;

      // --- 1st Gen Section ---
      content += `<b style="color: #003865;"><u>1st Gen Lidar (1m)</u></b><br>`;
      if (elev1st !== null) {
        content += `${elev1st.toFixed(2)} meters | ${(elev1st * 3.28084).toFixed(1)} feet<br>`;
      } else {
        content += `<span style="color: #A6192E; font-size: 11px;">Data not available in this area</span><br>`;
      }

      // --- Coordinates Section ---
      content += `<hr style="border: none; border-top: 1px solid #ccc; margin: 8px 0 4px 0;">
        <b><u>WGS 84</u></b><br>
        Lat: ${lat}, Lon: ${lng}<br><br>
        <b><u>NAD83 UTM 15 - NAVD88</u></b><br>
        E: ${easting} m, N: ${northing} m
      </div>`;

      L.popup(popupOptions)
        .setLatLng(latlng)
        .setContent(content)
        .openOn(map);

      map.once('popupclose', function () {
        if (customMarker) {
          map.removeLayer(customMarker);
          customMarker = null;
        }
      });

      if (activeToolType === 'marker') {
        setTimeout(() => { if (currentDrawHandler) currentDrawHandler.enable(); }, 100);
      }
    });
  }

// --- Logic for POLYGON (Lidar Downloads) ---
if (layer instanceof L.Polygon) {
  // Get the area in Square Miles
  // L.GeometryUtil.geodesicArea returns square meters. 
  // We multiply by 0.0000003861 to get Square Miles.
  const latlngs = layer.getLatLngs()[0];
