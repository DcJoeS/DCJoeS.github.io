// Optional proj defs
if (typeof proj4 !== 'undefined') {
  proj4.defs("EPSG:4326", "+proj=longlat +datum=WGS84 +no_defs");
  proj4.defs("EPSG:6344", "+proj=utm +zone=15 +datum=NAD83 +units=m +no_defs +type=crs");
}

    // Convert LatLng to UTM Zone 15N
  function latLngToUTM15(latlng) {
    if (typeof proj4 === 'undefined') return null;

    // proj4 expects [lon, lat]
    const [easting, northing] = proj4(
      "EPSG:4326",
      "EPSG:6344",
      [latlng.lng, latlng.lat]
    );

    return {
      easting,
      northing,
      zone: "15N"
    };
  }
