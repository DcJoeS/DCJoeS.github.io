// HELPER: completely reset drawing state
function resetMapDrawing() {
  if (currentDrawHandler) {
    currentDrawHandler.disable();
    currentDrawHandler = null;
  }
  activeToolType = null; // Reset the tracker
  
function resetMapDrawing() {
  map.closePopup(); 
  
  if (currentDrawHandler) {
    currentDrawHandler.disable();
    currentDrawHandler = null;
  }
  activeToolType = null; 
  
  document.querySelectorAll('.zoom-to-mn').forEach(btn => {
    btn.classList.remove('active-tool');
  });

  drawnItems.clearLayers();
  if (customMarker) {
    map.removeLayer(customMarker);
    customMarker = null;
  }
  if (profilePanel) {
    profilePanel.classList.remove('visible');
    profilePanel.setAttribute('aria-hidden', 'true');
  }
  if (spinner) spinner.style.display = 'none';
  
  // Also kill any active fetches when the map is reset
  if (activeAbortController) activeAbortController.abort();
}

  // Remove active class from all custom buttons
  document.querySelectorAll('.zoom-to-mn').forEach(btn => {
    btn.classList.remove('active-tool');
  });

  drawnItems.clearLayers();
  if (customMarker) {
    map.removeLayer(customMarker);
    customMarker = null;
  }
  if (profilePanel) {
    profilePanel.classList.remove('visible');
    profilePanel.setAttribute('aria-hidden', 'true');
  }
  if (spinner) spinner.style.display = 'none';
}

