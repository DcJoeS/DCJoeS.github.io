// Helper: Fetch USGS 3DEP Lidar Point Cloud data
// Add externalSignal as the second parameter
async function fetchUSGSPointCloud(geojson, externalSignal, retries = 3) {
  try {
    const bounds = L.geoJSON(geojson).getBounds();
    const west = bounds.getWest().toFixed(4);
    const south = bounds.getSouth().toFixed(4);
    const east = bounds.getEast().toFixed(4);
    const north = bounds.getNorth().toFixed(4);
    
    const bbox = [west, south, east, north].join(',');
    const url = `https://tnmaccess.nationalmap.gov/api/v1/products?datasets=Lidar%20Point%20Cloud%20(LPC)&bbox=${bbox}&prodFormats=LAZ&max=500`;
    
    const timeoutController = new AbortController();
    const timeoutId = setTimeout(() => timeoutController.abort(), 5000);

    // Combine your 5s timeout with the "kill switch" from the UI
    const combinedSignal = AbortSignal.any([externalSignal, timeoutController.signal]);

    const response = await fetch(url, { signal: combinedSignal });
    clearTimeout(timeoutId);

    if (!response.ok) throw new Error('USGS Server Error');
    const data = await response.json();
    
    if ((!data.items || data.items.length === 0) && retries > 0) {
      console.warn(`USGS returned 0 items. Retrying... (${retries} left)`);
      await new Promise(res => setTimeout(res, 1000));
      // Pass externalSignal through to the retry!
      return fetchUSGSPointCloud(geojson, externalSignal, retries - 1);
    }

    return data.items || [];
  } catch (e) {
    if (e.name === 'AbortError') {
      if (externalSignal && externalSignal.aborted) {
        console.log("USGS Fetch killed: user started new drawing.");
        return null; 
      }
    }
    if (retries > 0) {
      return fetchUSGSPointCloud(geojson, externalSignal, retries - 1);
    }
    return null; 
  }
}

// Add layer control and keep a reference
const layerControl = L.control.layers(baseMaps, overlayMaps, { collapsed: true }).addTo(map);

function wrapLayersInFieldsets() {
  const container = layerControl.getContainer();
  if (!container) return;

  // Handle Basemaps fieldset
  const baseGroup = container.querySelector('.leaflet-control-layers-base');
  if (baseGroup && !baseGroup.querySelector('fieldset')) {
    const fieldset = document.createElement('fieldset');
    const legend = document.createElement('legend');
    legend.textContent = 'Basemaps';
    fieldset.appendChild(legend);
    while (baseGroup.firstChild) {
      fieldset.appendChild(baseGroup.firstChild);
    }
    baseGroup.appendChild(fieldset);
  }

  // Handle Overlays fieldset
  const overlayGroup = container.querySelector('.leaflet-control-layers-overlays');
  if (overlayGroup && !overlayGroup.querySelector('fieldset')) {
    const fieldset = document.createElement('fieldset');
    const legend = document.createElement('legend');
    legend.textContent = 'Map Layers';
    fieldset.appendChild(legend);
    
    while (overlayGroup.firstChild) {
      fieldset.appendChild(overlayGroup.firstChild);
    }
    overlayGroup.appendChild(fieldset);

    // Inject Collapsible Headers
    const labels = fieldset.querySelectorAll('label');
    
    // startOpen property to control initial state
    const headerMap = [
      { startText: 'Contours 2nd Gen (Dynamic)', header: '2nd Gen Lidar (2021-2024)', startOpen: true },
      { startText: 'Contours (50 ft) 1st Gen', header: '1st Gen Lidar (2008-2012)', startOpen: false },
      { startText: 'County Boundaries', header: 'Reference Data', startOpen: false }
    ];

    labels.forEach(label => {
      const text = label.textContent.trim();
      
      headerMap.forEach(item => {
        if (text === item.startText) {
          const headerDiv = document.createElement('div');
          headerDiv.className = 'layer-group-header';
          headerDiv.innerHTML = `
            <strong>${item.header}</strong>
            <i class="fa-solid fa-chevron-down toggle-icon"></i>
          `;
          
L.DomEvent.on(headerDiv, 'click', function(e) {
            L.DomEvent.stopPropagation(e);
            
            const icon = this.querySelector('.toggle-icon');
            const isCollapsed = this.classList.toggle('collapsed-group');
            
            let next = this.nextElementSibling;
            while (next && !next.classList.contains('layer-group-header')) {
              // Toggle visibility
              next.style.display = isCollapsed ? 'none' : 'block';
              next = next.nextElementSibling;
            }

            if (isCollapsed) {
                icon.classList.replace('fa-chevron-down', 'fa-chevron-right');
            } else {
                icon.classList.replace('fa-chevron-right', 'fa-chevron-down');
            }

            const controlContainer = layerControl.getContainer();
            if (controlContainer.classList.contains('leaflet-control-layers-expanded')) {
                controlContainer.style.height = 'auto';
            }
          });

          fieldset.insertBefore(headerDiv, label);
          
          if (!item.startOpen) {
            headerDiv.click(); 
          }
        }
      });
    });
  }
}
// Call after adding layer control
wrapLayersInFieldsets();

//Opacity Slider Function - adds a slider to the layer control for a given layer and label text
function addOpacitySlider(layer, labelText) {
  setTimeout(() => {
    const overlays = document.querySelectorAll('.leaflet-control-layers-overlays label');
    overlays.forEach(label => {
      const visibleText = label.innerText.trim();

      if (visibleText === labelText) {
        if (label.querySelector('.layer-opacity-container')) return;

        // Create a wrapper container
        const sliderWrapper = document.createElement('div');
        sliderWrapper.className = 'layer-opacity-container';
        sliderWrapper.style.display = 'flex';
        sliderWrapper.style.alignItems = 'center';
        sliderWrapper.style.gap = '8px';
        sliderWrapper.style.paddingLeft = '25px';
        sliderWrapper.style.marginTop = '4px';

        // Add a transparency icon (FontAwesome - since you already use it)
        const icon = document.createElement('i');
        icon.className = 'fa-solid fa-circle-half-stroke';
        icon.style.fontSize = '10px';
        icon.style.color = '#666';

        // Create the slider
        const slider = document.createElement('input');
        slider.type = 'range';
        slider.min = 0;
        slider.max = 100;
        slider.value = (layer.options.opacity || 1.0) * 100;
        slider.style.width = '70px';
        slider.style.height = '6px';
        slider.style.cursor = 'pointer';

        // Create the percentage display
        const percentLabel = document.createElement('span');
        percentLabel.innerText = slider.value + '%';
        percentLabel.style.fontSize = '10px';
        percentLabel.style.minWidth = '25px';
        percentLabel.style.color = '#666';

        // Update opacity AND label on input
        slider.oninput = function() {
          layer.setOpacity(this.value / 100);
          percentLabel.innerText = this.value + '%';
        };

        L.DomEvent.disableClickPropagation(sliderWrapper);

        // Assemble everything
        sliderWrapper.appendChild(icon);
        sliderWrapper.appendChild(slider);
        sliderWrapper.appendChild(percentLabel);
        label.appendChild(sliderWrapper);
      }
    });
  }, 100);
}

