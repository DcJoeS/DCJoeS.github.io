// Initialize the geojson layer with a fallback style
const lidarStatusLayer = L.geoJSON(null, {
  pane: 'statusPane', 
  interactive: false,
  style: function (feature) {
    // Determine color based on "name" or fallback to orange
    const color = getLidarColor(feature.properties.name || ""); 
    return { 
      weight: 2, 
      opacity: 1, 
      color: 'white',      // Outline
      fillColor: color,    // Fill
      fillOpacity: 0.8,
      className: 'soft-status-edge' // Add a class for CSS blurring
    };
  },
});

// Fetch with Debugging
fetch('https://g46prsaddst01.blob.core.windows.net/mntopo/mntopo2json/lidarStatus4326_2.geojson')
  .then(response => {
    if (!response.ok) throw new Error("HTTP error " + response.status);
    return response.json();
  })
  .then(data => {
    console.log("GeoJSON Data Received:", data);
    
    // Safety check: verify coordinates are in WGS84 (approx -94, 46)
    const firstCoord = data.features[0].geometry.coordinates[0][0][0];
    if (Math.abs(firstCoord) > 180) {
      console.error("COORD ERROR: Data is in UTM or Web Mercator, not Lat/Lng. It will not show up in the right place!");
    }

    lidarStatusLayer.addData(data);
    console.log("Features added to map.");
  })
  .catch(err => {
    console.error("Fetch failed. Is CORS enabled on the Blob?", err);
  });

// Lidar Status Color Function
function getLidarColor(name) {
  const n = name.toLowerCase();
  if (n.includes("data forthcoming")) return "#008EAA";
  if (n.includes("data not available")) return "#FFC845";
  return "orange"; // Default for everything else
}

