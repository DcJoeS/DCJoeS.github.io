  style: function(feature) {
    // We'll make unmodernized slightly different (brownish) to distinguish them
    return { color: '#FFEBBE', weight: 1, fillOpacity: 0.9 }; 
  },
  pane: "femaPane"
});

// COMBINE THEM into one single const
const fema = L.layerGroup([layerUM, layerM]);

// DEM 1st Gen image layer (Esri TileMap)
const demLayer1stGen = L.esri.tiledMapLayer({
  url: demLayer1stGenUrl, 
  opacity: 0.65,
  pane: "demPane"
});

// State management
let currentContourRGB = [254, 204, 52]; // Default Yellow

// Define the Legend Object
const contourLegend = L.control({ position: 'bottomright' });

// Function to build the HTML based on current state (Color + Zoom)
function updateContourLegendHTML(div) {
    if (!div) return;
    
    const colorStr = `rgb(${currentContourRGB.join(',')})`;
    const intervals = getCurrentIntervals();

    // Zoomed Out State
    if (intervals.reg === 0) {
        div.innerHTML = `
            <div class="contour-legend">
                <div style="font-weight:bold;">Dynamic Contours</div>
                <div style="font-size:9px; color:#666; line-height: 1.1;">Not authoritative 3D Geo Contours</div>
                <div style="font-size:10px; color:#666; margin-top:5px;">Zoom in to view</div>
            </div>`;
        return;
    }

    // Active State (Zoomed In)
    div.innerHTML = `
        <div class="contour-legend">
            <div style="font-weight:bold;">Dynamic Contours</div>
            <div style="font-size:9px; color:#666; line-height: 1.1; margin-bottom: 5px;">Not authoritative 3D Geo Contours</div>
            <div style="margin-bottom: 4px;">
                <span class="contour-legend-line" style="border-top: 3px solid ${colorStr};"></span>
                <span>Index (${intervals.idx} ft)</span>
            </div>
            <div>
                <span class="contour-legend-line" style="border-top: 1px solid ${colorStr}; opacity: 0.7;"></span>
                <span>Intermediate (${intervals.reg} ft)</span>
            </div>
        </div>
    `;
}

contourLegend.onAdd = function () {
    const div = L.DomUtil.create('div', 'leaflet-control');
    updateContourLegendHTML(div);
    return div;
};

// Updated Helper: Adds "Remap" so the Colormap actually finds the lines
function getContourRule(interval) {
  return {
    "rasterFunction": "Colormap",
    "rasterFunctionArguments": {
      "Colormap": [
        // Ensure this uses the global currentContourRGB
        [1, currentContourRGB[0], currentContourRGB[1], currentContourRGB[2]]
      ],
      "Raster": {
        "rasterFunction": "Remap",
        "rasterFunctionArguments": {
          "InputRanges": [-1000, 20000], 
          "OutputValues": [1],        
          "Raster": {
            "rasterFunction": "Contour",
            "rasterFunctionArguments": {
              "ContourInterval": interval,
              "BaseContour": 0,
              "ZFactor": 3.28084
            }
          }
        }
      }
    }
  };
}

// Initialize TWO layers instead of one
const regularContours = L.esri.imageMapLayer({
  url: demLayerUrl,
  renderingRule: getContourRule(1),
  format: 'png32',
  opacity: 0,
  pane: "contourPane"
})

const indexContours = L.esri.imageMapLayer({
  url: demLayerUrl,
  renderingRule: getContourRule(5),
  format: 'png32',
  opacity: 0,
  pane: "contourPane"
})

const combinedContours = L.layerGroup([regularContours, indexContours]);

// Updated Logic to control both layers
function updateDynamicContours() {
  // Always calculate the correct intervals for the current zoom level first
  const z = map.getZoom();
  let regInterval = 0;
  let idxInterval = 0;

  if (z >= 18) { regInterval = 1; idxInterval = 5; }
  else if (z >= 16) { regInterval = 2; idxInterval = 10; }
  else if (z >= 15) { regInterval = 10; idxInterval = 50; }
  else if (z >= 12) { regInterval = 50; idxInterval = 250; }

  // STOP if the layer group isn't actually on the map
  if (!map.hasLayer(combinedContours)) return;
    if (map.hasLayer(combinedContours)) {
        const container = contourLegend.getContainer();
        if (container) updateContourLegendHTML(container);
    }

  // If zoomed out too far, hide them (Opacity 0)
  if (regInterval === 0) {
    regularContours.setOpacity(0);
    indexContours.setOpacity(0);
  } else {
    // If in range, set opacities and force the new Rendering Rule
    regularContours.setOpacity(0.4); 
    indexContours.setOpacity(1);
    
    // Explicitly set the rules to force a refresh from the server
    regularContours.setRenderingRule(getContourRule(regInterval));
    indexContours.setRenderingRule(getContourRule(idxInterval));

  }
}

// LiDAR Status Legend
const lidarStatusLegend = L.control({ position: 'bottomright' });

lidarStatusLegend.onAdd = function () {
  // Use 'fema-legend' class here instead of 'status-legend-panel'
  const div = L.DomUtil.create('div', 'leaflet-control fema-legend'); 
  
  L.DomEvent.disableClickPropagation(div);

  // Match the FEMA legend
  div.innerHTML = `
    <div class="legend-title">DEM Availability (0.5 meter)</div>
    <div class="legend-item">
      <span class="legend-color" style="background:#008EAA;"></span>
      <span class="legend-label">Data forthcoming</span>
    </div>
    <div class="legend-item">
      <span class="legend-color" style="background:#FFC845;"></span>
      <span class="legend-label">Data not available</span>
    </div>
  `;
  return div;
};

// Updated Zoom Listener (Handles both Contours and FEMA)
map.on('zoomend', function() {
  // Update Contours
  updateDynamicContours();

  // Update FEMA legend if it's currently on the map
  if (map.hasLayer(fema)) {
    const container = femaLegend.getContainer();
    if (container) updateFemaLegendHTML(container);
  }
});

// Updated Overlay Listeners
map.on('overlayadd', function(e) {
  // If Contours toggled on
  if (e.layer === combinedContours) {
    updateDynamicContours();
    // Also ensure the contour legend is added (if not already handled)
    contourLegend.addTo(map);
  }
  
  // If FEMA toggled on
  if (e.layer === fema) {
    femaLegend.addTo(map);
    const container = femaLegend.getContainer();
    if (container) updateFemaLegendHTML(container);
  }

  // LiDAR Status check
  if (e.layer === lidarStatusLayer) {
    lidarStatusLegend.addTo(map);
  }

  //DEM layers check
  if (e.layer === demLayer || e.layer === demLayerColorized || e.layer === demLayerTerrain || e.layer === demLayer1stGen) {
    refreshElevationLegend();
  }
});

map.on('overlayremove', function(e) {
  if (e.layer === combinedContours) {
    contourLegend.remove();
  }
  if (e.layer === fema) {
    map.removeControl(femaLegend);
  }

    // LiDAR Status remove check
  if (e.layer === lidarStatusLayer) {
    lidarStatusLegend.remove();
  }

  //DEM Legened remove check
  if (e.layer === demLayer || e.layer === demLayerColorized || e.layer === demLayerTerrain || e.layer === demLayer1stGen) {
     refreshElevationLegend();
   } 
});

// Run once on initial load
updateDynamicContours();

