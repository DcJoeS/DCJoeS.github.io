// Flight swaths (paginated loader and styling)
const flightLinesGroup = L.featureGroup();

function isValidHttpUrl(value) {
  try {
    const url = new URL(value);
    return url.protocol === "http:" || url.protocol === "https:";
  } catch (e) {
    return false;
  }
}

function createFlightPopup(featureData) {
  const { name, workUnit, formattedDate, metadata } = featureData;

  const container = document.createElement('div');
  container.className = 'flight-popup';

  // Title
  const title = document.createElement('b');
  title.textContent = name;
  container.appendChild(title);
  container.appendChild(document.createElement('br'));

  // Divider
  const hr = document.createElement('hr');
  hr.style.border = 'none';
  hr.style.borderTop = '1px solid #78BE21';
  hr.style.margin = '4px 0';
  container.appendChild(hr);

  // Work Unit
  const wu = document.createElement('div');
  const wuLabel = document.createElement('b');
  wuLabel.textContent = 'Work Unit: ';
  wu.appendChild(wuLabel);

  const wuValue = document.createElement('span');
  wuValue.textContent = workUnit;
  wu.appendChild(wuValue);
  container.appendChild(wu);

  // Flight Date
  const fd = document.createElement('div');
  const fdLabel = document.createElement('b');
  fdLabel.textContent = 'Flight Date: ';
  fd.appendChild(fdLabel);

  const fdValue = document.createElement('span');
  fdValue.textContent = formattedDate;
  fd.appendChild(fdValue);
  container.appendChild(fd);

  // Metadata link (only if valid URL)
  if (metadata && isValidHttpUrl(metadata)) {
    const md = document.createElement('div');

    const mdLabel = document.createElement('b');
    mdLabel.textContent = 'Metadata: ';
    md.appendChild(mdLabel);

    const link = document.createElement('a');
    link.href = metadata;
    link.target = '_blank';
    link.rel = 'noopener noreferrer';
    link.textContent = 'Link';

    md.appendChild(link);
    container.appendChild(md);
  }

  return container;
}

function onEachFlightFeature(feature, layer) {
  const props = feature.properties || {};
  const name = props.name || props.FLIGHT_NAME || 'Unnamed Flight';
  const workUnit = props.work_unit || 'Unknown';
  const dateValue = props.date || props.FLIGHT_DATE;
  const metadata = props.metadata || null;

  // Format date safely
  let formattedDate = 'No date';
  if (dateValue) {
    const parsed = Number(dateValue);
    formattedDate = !isNaN(parsed)
      ? new Date(parsed).toISOString().split('T')[0]
      : dateValue;
  }

  // Build secure popup element
  const popupElement = createFlightPopup({
    name,
    workUnit,
    formattedDate,
    metadata
  });

  layer.bindPopup(popupElement);

  // Hover styling
  layer.on({
    mouseover: function () {
      this.setStyle({ weight: 3, color: '#FFC845', opacity: 1 });
    },
    mouseout: function () {
      this.setStyle({ color: '#5D295F', weight: 2, opacity: 0.8 });
    }
  });
}

// Fetch all features with pagination
function fetchAllFeatures(offset = 0, batchSize = 200) {
  const q = L.esri.query({ url: FLIGHT_URL });
  q.where('1=1').limit(batchSize).offset(offset).run(function (error, featureCollection) {
    if (error) {
      console.error('Query error:', error);
      return;
    }
    const geojsonLayer = L.geoJSON(featureCollection, {
      style: { color: '#5D295F', weight: 2, opacity: 0.8 },
      onEachFeature: onEachFlightFeature
    });
    flightLinesGroup.addLayer(geojsonLayer);

    // Continue pagination if needed
    if (featureCollection.features.length === batchSize) {
      fetchAllFeatures(offset + batchSize, batchSize);
    } else {
      console.log('All flight swaths loaded (or batch complete)');
    }
  });
}

