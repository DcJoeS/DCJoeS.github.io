});

// Function to update the URL with current Lat, Lng, and Zoom
function updateURL() {
  const center = map.getCenter();
  const zoom = map.getZoom();
  
  // Create a new URL object based on the current location
  const url = new URL(window.location);
  
  // Set the parameters (rounded to 5 decimals for cleanliness)
  url.searchParams.set('lat', center.lat.toFixed(5));
  url.searchParams.set('lng', center.lng.toFixed(5));
  url.searchParams.set('z', zoom);
  
  // Update the address bar WITHOUT refreshing the page
  // We use replaceState so we don't clog the user's "Back" button history
  window.history.replaceState({}, '', url);
}

// Listen for map movements and zooms
map.on('moveend zoomend', updateURL);

