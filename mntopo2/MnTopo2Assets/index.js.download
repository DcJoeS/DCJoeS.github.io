// Accessibility: set ARIA label on geocoder input drawer mouse marker
const observer = new MutationObserver((mutations) => {
  // Geocoder Input
  const geocoderInput = document.querySelector('.geocoder-control-input');
  if (geocoderInput && !geocoderInput.hasAttribute('aria-label')) {
    geocoderInput.setAttribute('aria-label', 'Search for a Minnesota location');
    geocoderInput.addEventListener('focus', () => {
        setTimeout(() => {
            window.scrollTo(0, 0);
            document.body.scrollTop = 0;
        }, 50);
    });
  }

  // Leaflet Draw "Mouse Marker"
  // This finds the phantom marker that follows the mouse during drawing
  const mouseMarker = document.querySelector('.leaflet-mouse-marker');
  if (mouseMarker && !mouseMarker.hasAttribute('aria-label')) {
    mouseMarker.setAttribute('aria-label', 'Map drawing helper');
    mouseMarker.setAttribute('aria-hidden', 'true');
    mouseMarker.setAttribute('tabindex', '-1'); 
  }
});

