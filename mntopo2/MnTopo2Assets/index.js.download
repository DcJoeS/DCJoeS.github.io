// Generate terrain colormap
function generateAdvancedTerrainColormap() {
    const colors = [];

const stops = [
    { value: 0,   color: [175, 240, 233] }, // AFF0E9
    { value: 36,  color: [255, 255, 178] }, // FFFFB2
    { value: 72,  color: [0, 128, 64] },   // 008040
    { value: 108, color: [247, 200, 35] },  // F7C823
    { value: 144, color: [128, 0, 0] },     // 800000
    { value: 180, color: [122, 63, 18] },   // 7A3F12
    { value: 216, color: [185, 185, 185] }, // B9B9B9
    { value: 255, color: [253, 253, 254] }  // FDFDFE
];
    for (let i = 0; i <= 255; i++) {
        // Find which two stops i falls between
        let lower = stops[0], upper = stops[stops.length - 1];
        for (let j = 0; j < stops.length - 1; j++) {
            if (i >= stops[j].value && i <= stops[j + 1].value) {
                lower = stops[j];
                upper = stops[j + 1];
                break;
            }
        }

        // Interpolation factor
        const t = (i - lower.value) / (upper.value - lower.value);

        // Interpolate RGB
        const r = Math.round(lower.color[0] + t * (upper.color[0] - lower.color[0]));
        const g = Math.round(lower.color[1] + t * (upper.color[1] - lower.color[1]));
        const b = Math.round(lower.color[2] + t * (upper.color[2] - lower.color[2]));

        colors.push([i, r, g, b]);
    }

    return colors;
}

