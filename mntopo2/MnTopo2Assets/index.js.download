//accessible colormap generation
function generateColormap() {
    const colors = [];

    const stops = [
        { value: 0, color: [8, 104, 172] },  // deep blue (lowest elevation)
        {value: 64, color: [67,162,202]}, 
        {value: 128, color: [123,204,196]}, 
        {value: 192, color: [186,228,188]}, 
        {value: 255, color: [240,249,232]}  // light teal (highest elevation)
    ];

    for (let i = 0; i <= 255; i++) {
        // Find which two stops i falls between
        let lower = stops[0], upper = stops[stops.length - 1];
        for (let j = 0; j < stops.length - 1; j++) {
            if (i >= stops[j].value && i <= stops[j + 1].value) {
                lower = stops[j];
                upper = stops[j + 1];
                break;
            }
        }

        // Interpolation factor
        const t = (i - lower.value) / (upper.value - lower.value);

        // Interpolate RGB
        const r = Math.round(lower.color[0] + t * (upper.color[0] - lower.color[0]));
        const g = Math.round(lower.color[1] + t * (upper.color[1] - lower.color[1]));
        const b = Math.round(lower.color[2] + t * (upper.color[2] - lower.color[2]));

        colors.push([i, r, g, b]);
    }

    return colors;
}

//rendering rule for accessible colormap
const renderingRule2 = {
  "rasterFunction": "Colormap",
  "rasterFunctionArguments": {
    "Colormap": generateColormap(),
    "Raster": {
      "rasterFunction": "Resample",
      "rasterFunctionArguments": {
        "ResamplingType": 1, // 1 = Bilinear
        "InputCellsize": {
          "x": 0.5,
          "y": 0.5
        },
        "Raster": {
          "rasterFunction": "Stretch",
          "rasterFunctionArguments": {
            "StretchType": 5,
            "DRA": true,
